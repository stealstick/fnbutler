# butler.view 환경변수 — 이 파일을 .env.local 로 복사해 사용

# 텔레그램 봇 토큰 (없으면 알림 발송만 비활성, 나머지 기능 정상)
# @BotFather 에서 발급 → /settings 의 '텔레그램 연결' 버튼이면 chat_id 자동 등록
BUTLER_TELEGRAM_BOT_TOKEN=

# 웹훅 위조 검증 시크릿 (선택, 권장). setWebhook 의 secret_token 과 동일하게.
# 예: openssl rand -hex 24
BUTLER_TELEGRAM_WEBHOOK_SECRET=

# 봇 username 강제 지정(선택). 미설정 시 getMe 로 자동 조회. @ 없이.
# BUTLER_TELEGRAM_BOT_USERNAME=

# 알림 메시지/딥링크에 들어갈 외부 접속 URL (기본 http://localhost:3939)
BUTLER_BASE_URL=http://localhost:3939

# Postgres 접속 문자열. 로컬은 `npm run db:setup:local` 실행 후 아래 기본값 사용.
BUTLER_DATABASE_URL=postgres://butler:butler@localhost:5432/butler

# 관리자 계정 자동 생성/승격. 운영에서는 GitHub Actions 또는 GCP Secret Manager
# secret으로 같은 이름을 설정하면 /admin 접근용 계정이 준비된다.
# BUTLER_ADMIN_EMAIL=
# BUTLER_ADMIN_PASSWORD=

# Cloud SQL/Cloud Run 에서는 connection string 대신 PG* 환경변수를 써도 된다.
# PGHOST=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
# PGDATABASE=butler
# PGUSER=butler
# PGPASSWORD=

# butler 업스트림 분당 요청 상한 (기본 80, user rate limit 100/60s 보다 낮게)
# BUTLER_RATE_PER_MIN=80

# butler API 베이스 (기본 https://api.butler.works)
# BUTLER_API_BASE=

# Nasdaq 기업 시총 USD→KRW 환산. USD_KRW_RATE가 없으면 공개 환율 API를 시도하고,
# 실패 시 USD_KRW_FALLBACK(기본 1400)을 쓴다.
# NASDAQ_COMPANY_LIMIT=500
# USD_KRW_RATE=
# USD_KRW_FALLBACK=1400

# FMP 해외 컨센서스 추정치. 무료 플랜은 250 calls/day 기준이라 기본 240콜만 사용한다.
# period=annual 추정치만 무료 플랜에서 확인됨. quarter 및 bulk target은 유료 제한.
# FMP_API_KEY=
# FMP_DAILY_CALL_BUDGET=240
# FMP_CALL_DELAY_MS=2500
# FMP_ESTIMATE_LIMIT=10
# FMP_TARGET_CALLS_PER_DAY=0

# Yahoo Finance 웹 JSON 기반 NASDAQ 목표가/분기·연간 추정치 보강.
# 비공식 endpoint라 실패 시 기존 데이터는 보존하고 다음 실행 때 재시도한다.
# YAHOO_NASDAQ_LIMIT=30
# YAHOO_CALL_DELAY_MS=2500
# YAHOO_JITTER_MS=750
# YAHOO_SESSION_RETRIES=3
# YAHOO_SESSION_RETRY_DELAY_MS=60000
# YAHOO_COOKIE=
# YAHOO_CRUMB=
# YAHOO_OVERWRITE_ESTIMATES=0
# YAHOO_OVERWRITE_TARGETS=0
