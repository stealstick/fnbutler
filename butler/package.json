{
  "name": "keystone",
  "version": "0.1.0",
  "private": true,
  "description": "Keystone 목표주가/컨센서스 리서치 데스크 + 자체 Postgres 정규화 DB + 기업/증권사 비교 뷰",
  "scripts": {
    "dev": "next dev -p 3939",
    "build": "next build",
    "start": "next start -p 3939",
    "lint": "next lint",
    "db:setup:local": "tsx scripts/setup-local-postgres.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts --source db/butler.db",
    "ingest:companies": "tsx scripts/ingest.ts --companies",
    "ingest:seed": "tsx scripts/ingest.ts --companies --detail --limit 40",
    "ingest:detail": "tsx scripts/ingest.ts --detail",
    "ingest:all": "tsx scripts/ingest.ts --companies --detail --all",
    "backfill:sectors": "tsx scripts/backfill-sectors.ts",
    "backfill:changes": "tsx scripts/backfill-changes.ts",
    "backfill:dart-financials": "tsx scripts/backfill-dart-financials.ts --latest",
    "backfill:wisereport-estimates": "tsx scripts/backfill-wisereport-estimates.ts",
    "backfill:summaries": "tsx scripts/backfill-summaries.ts",
    "import:har": "tsx scripts/import-har.ts",
    "poll": "tsx scripts/poll-daily.ts",
    "poll:watchlist": "tsx scripts/poll-daily.ts --scope watchlist",
    "refresh": "tsx scripts/refresh-daily.ts",
    "refresh:calendar": "tsx scripts/refresh-daily.ts --calendar-only",
    "deploy:postgres": "bash scripts/gcloud-postgres-bootstrap.sh",
    "postgres:import:cloud": "bash scripts/gcloud-postgres-import-local.sh",
    "ingest:covered": "tsx scripts/ingest-covered.ts",
    "ingest:calendar": "tsx scripts/ingest-calendar.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "next": "^15.5.19",
    "pg": "^8.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
