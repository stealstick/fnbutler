# DB 접속 문자열. 미설정 시 sqlite:///data/fnguide.db
# PostgreSQL 예: postgresql+psycopg://user:pass@localhost:5432/fnguide
DATABASE_URL=

# fnguide 세션 쿠키 파일 경로 (기본: .secrets/cookie.txt)
# 브라우저 DevTools > Network > 아무 요청 > Request Headers > cookie 값 전체를 붙여넣기
FNGUIDE_COOKIE_FILE=.secrets/cookie.txt

# 요청 간 대기(초) — 서버 부하 방지
FNGUIDE_REQUEST_DELAY=1.0

# 비전 AI 폴백 (--ai 옵션). 설정 시 Anthropic SDK 사용, 미설정 시 claude CLI.
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=
FNGUIDE_VISION_MODEL=claude-sonnet-4-6
